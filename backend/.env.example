# Server
PORT=5002
NODE_ENV=development

# MongoDB connection string
DB_URI=mongodb://127.0.0.1:27017/threatlens

# Secrets (required in production - use long random strings)
JWT_SECRET=change-me
COOKIE_SECRET=change-me-too

# Where the frontend runs (used for redirects and CORS)
CLIENT_URL=http://localhost:5173

# Optional: Google sign-in. Leave blank to run in guest mode.
# In development the Vite dev server proxies /auth, so the callback goes through port 5173.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/auth/google/callback

# Upload limits
MAX_UPLOAD_MB=10
MAX_ROWS=25000

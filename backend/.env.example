# Server
PORT=5002
NODE_ENV=development

# MongoDB connection string
DB_URI=mongodb://127.0.0.1:27017/threatlens

# Signs workspace cookies (required in production - use a long random string)
COOKIE_SECRET=change-me

# Where the frontend runs (used for CORS)
CLIENT_URL=http://localhost:5173

# Upload limits
MAX_UPLOAD_MB=10
MAX_ROWS=25000
